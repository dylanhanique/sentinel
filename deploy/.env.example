# Copier en .env pour surcharger les valeurs par défaut (le fichier .env n'est PAS versionné).
# Sans .env, docker-compose utilise des valeurs de développement.
POSTGRES_ADMIN_PASSWORD=postgres
API_DB_PASSWORD=api_pwd
CHECKER_DB_PASSWORD=checker_pwd
ALERT_DB_PASSWORD=alert_pwd
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=sentinel
