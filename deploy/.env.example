# ============================================================
# Configuration locale de Sentinel
# ============================================================
# Ce fichier est un MODÈLE. Il est facultatif : sans lui, les valeurs par défaut
# de docker-compose.yml et de application.yml fonctionnent en développement.
# Pour changer une valeur : cp .env.example .env, puis modifier .env
# (.env n'est PAS versionné).
#
# ATTENTION : deux outils, deux façons de lire la configuration.
#   - Docker Compose lit ce fichier (deploy/.env) automatiquement.
#   - Spring Boot NE lit PAS ce fichier. Il lit les variables d'environnement
#     réelles du processus (shell, configuration de lancement de l'IDE, conteneur).
# Ce sont des valeurs de DÉVELOPPEMENT : en production, elles sont surchargées
# par des secrets (variables d'environnement, secrets Kubernetes).

# ------------------------------------------------------------
# 1. Docker Compose (lues depuis ce fichier)
# ------------------------------------------------------------
POSTGRES_ADMIN_PASSWORD=postgres

# Mots de passe des rôles créés au premier démarrage de PostgreSQL
# (voir deploy/postgres/init-databases.sh). Les noms d'utilisateur
# (api_user, checker_user, alert_user) sont écrits en dur dans ce script.
# ATTENTION : API_DB_PASSWORD est lue par Compose (création du rôle) ET par
# Spring (connexion). Si tu la modifies, exporte la même valeur avant de lancer
# l'application, sinon l'authentification échoue.
API_DB_PASSWORD=api_pwd
CHECKER_DB_PASSWORD=checker_pwd
ALERT_DB_PASSWORD=alert_pwd

# Un rôle PostgreSQL n'est créé qu'au premier démarrage d'un volume vide.
# Après avoir changé un mot de passe : make reset (supprime les données), puis make up.

RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=sentinel

# ------------------------------------------------------------
# 2. Spring Boot (à exporter dans l'environnement, pas lues depuis ce fichier)
# ------------------------------------------------------------
# Valeurs par défaut de application.yml, rappelées ici pour documentation.
# Décommente et exporte seulement pour surcharger.
# API_DB_URL=jdbc:postgresql://localhost:5432/api_db
# API_DB_USER=api_user
# API_DB_PASSWORD=api_pwd   (même variable que ci-dessus)